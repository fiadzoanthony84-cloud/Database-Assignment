QUESTION 28
MariaDB [introsql]> SELECT m.MOVIE_NUM, m.MOVIE_GENRE, ROUND(genre_avg.avg_cost, 2) AS 'Average Cost', m.MOVIE_COST AS 'Movie Cost', ROUND((m.MOVIE_COST - genre_avg.avg_cost)/genre_avg.avg_cost * 100, 2) AS 'Percent Difference' FROM MOVIE m JOIN (SELECT MOVIE_GENRE, AVG(MOVIE_COST) AS avg_cost FROM MOVIE GROUP BY MOVIE_GENRE) AS genre_avg ON m.MOVIE_GENRE = genre_avg.MOVIE_GENRE ORDER BY m.MOVIE_NUM;
